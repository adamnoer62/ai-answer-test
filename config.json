      "label": "GPT",
      "modelVariant": "",
      "color": "#19C37D",
      "colorDark": "#12A06A",
      "persona": null,
      "builtin": true
    },
    {
      "id": "claude",
      "engineId": "claude",
      "label": "Claude",
      "modelVariant": "",
      "color": "#FF9600",
      "colorDark": "#E08300",
